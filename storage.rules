rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /students/{uid}/drawings/{imageId} {
      allow read: if request.auth != null && (request.auth.uid == uid || request.auth.token.get('admin', false) == true);
      allow delete: if request.auth != null && request.auth.token.get('admin', false) == true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource != null && request.resource.contentType == 'image/png'
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() { return request.auth != null && request.auth.token.get('admin', false) == true; }
    match /{path=**}/activities/{activityId} {
      allow list: if isAdmin();
    }
    match /students/{uid}/activities/{activityId} {
      allow get: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email;
    }
  }
}
